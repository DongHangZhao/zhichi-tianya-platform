# 复制为 .env 后按需修改（本地开发可直接不建，使用默认值即可）

# 运行环境：development / production
FLASK_ENV=production

# 会话加密密钥（生产环境必须改成随机长字符串！）
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-random-64-hex-string

# 数据库连接串
# 不填 → 自动使用项目内 SQLite 文件（app.db）
# 填 PostgreSQL → 自动切换（Render/Neon/Supabase 等）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 端口（多数云平台会自动注入 PORT，本地可留空）
# PORT=5000
